ARG PAPERLESS_TAG=3.0.4

FROM ghcr.io/astral-sh/uv:0.11.32 AS uv

FROM ghcr.io/paperless-ngx/paperless-ngx:${PAPERLESS_TAG}

USER root

COPY --from=uv /uv /uvx /bin/

WORKDIR /tmp/paperless-paddleocr
COPY pyproject.toml uv.lock ./
RUN uv export --no-dev --no-emit-project --no-hashes \
      --output-file /tmp/paperless-paddleocr-requirements.txt \
    && uv pip install --system --no-cache -r /tmp/paperless-paddleocr-requirements.txt

COPY README.md ./
COPY src ./src
RUN uv pip install --system --no-deps . \
    && rm -rf /tmp/paperless-paddleocr /tmp/paperless-paddleocr-requirements.txt \
    && rm /bin/uv /bin/uvx
