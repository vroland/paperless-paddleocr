# Set this to the exact Paperless-ngx image tag deployed in production.
PAPERLESS_TAG=3.0.4
PAPERLESS_PORT=8000
PAPERLESS_SECRET_KEY=development-only-change-this-before-use
PAPERLESS_TIME_ZONE=UTC
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=admin-dev-password
PAPERLESS_ADMIN_MAIL=admin@example.invalid

# URL of the separately deployed PaddleOCR-VL layout-parsing service.
PAPERLESS_PADDLEOCR_URL=http://paddleocr.example.invalid:8088
PAPERLESS_PADDLEOCR_SCORE=21
